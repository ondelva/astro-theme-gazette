---
import type { ComponentProps } from 'astro/types';
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';
import SEO from '../components/common/SEO.astro';
import Analytics from '../components/common/Analytics.astro';
import DemoBar from '../components/common/DemoBar.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';
import { features, nav, site } from '../config';
import { fmt, useT } from '../i18n/t';

// `nameplate` prints the wordmark in the sticky bar. The home page sets it false: there the
// nameplate is the cover, printed full width, and a second small one above it reads as a repeat.
type Props = ComponentProps<typeof SEO> & { nameplate?: boolean };
const { nameplate = true, ...seoProps } = Astro.props;
const year = new Date().getFullYear();
const t = useT();
---

<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {/* The three faces from the fonts block in astro.config.mjs. Without these the site
        renders in the system fallbacks the browser picks. Preload what is above the fold:
        body 400, the two UI weights, and the display weights the nameplate and covers use.
        A face that is not preloaded swaps in late and shifts the page -- Archivo alone cost
        CLS 0.35 and 12 Lighthouse points before it was added here. */}
    <Font cssVariable="--font-body" preload={[{ weight: '400', style: 'normal' }]} />
    <Font
      cssVariable="--font-heading"
      preload={[
        { weight: '400', style: 'normal' },
        { weight: '500', style: 'normal' },
      ]}
    />
    <Font
      cssVariable="--font-display"
      preload={[
        { weight: '700', style: 'normal' },
        { weight: '700', style: 'italic' },
      ]}
    />
    <SEO {...seoProps} />
    <script is:inline>
      // Before first paint, or the page flashes the system theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.setAttribute('data-theme', saved);
      } catch {}
    </script>
    <Analytics />
  </head>
  <body class="bg-background text-foreground flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-foreground text-background font-ui sr-only z-50 text-sm no-underline focus:fixed focus:top-4 focus:left-4 focus:not-sr-only focus:px-4 focus:py-2"
    >
      {t.skipToContent}
    </a>

    <DemoBar />

    <header class="bg-background border-border sticky top-0 z-40 border-b">
      <div class="max-w-wide mx-auto flex flex-wrap items-baseline gap-x-4 gap-y-1 px-4 py-3">
        {nameplate && (
          <a class="font-cover shrink-0 text-xl font-bold no-underline" href="/">
            {site.name}
          </a>
        )}
        {/* One group, so a narrow screen stacks the links and the theme control under the
            nameplate, flush left like everything else, instead of dropping a single control
            onto a ragged line of its own. */}
        <div class="flex w-full flex-wrap items-baseline gap-x-4 gap-y-1 sm:ms-auto sm:w-auto sm:justify-end">
          <nav aria-label={t.mainNav} class="font-ui flex items-baseline gap-4 text-sm">
            {nav.header.map((item) => (
              <a class="hover:text-primary no-underline" href={item.href}>
                {item.label}
              </a>
            ))}
          </nav>
          {features.darkMode && <ThemeToggle />}
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>

    <footer class="border-foreground mt-16 border-t-[3px]">
      <div class="max-w-wide mx-auto flex flex-wrap justify-between gap-x-12 gap-y-8 px-4 py-10 sm:py-14">
        <div class="max-w-[28ch]">
          <p class="font-cover text-2xl font-bold">{site.name}</p>
          <p class="text-muted mt-2 text-sm">{site.description}</p>
        </div>
        {nav.footer.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="font-ui text-sm font-medium">{group.title}</h2>
            <ul class="font-ui text-muted mt-3 space-y-2 text-sm">
              {group.links.map((link) => (
                <li>
                  <a class="hover:text-primary no-underline" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
        {nav.social.length > 0 && (
          <ul class="flex items-start gap-4">
            {nav.social.map((link) => (
              <li>
                <a class="hover:text-primary block" href={link.href} aria-label={link.label}>
                  <Icon name={link.icon} class="size-5" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <p class="max-w-wide font-ui text-muted mx-auto px-4 pb-10 text-xs">
        &copy; {year} {site.name}. {fmt(t.editedBy, { name: site.author })}.
      </p>
    </footer>
  </body>
</html>
