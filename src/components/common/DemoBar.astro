---
// Demo-site only: renders nothing unless PUBLIC_DEMO_BUY_URL is set at build time, so a buyer's
// build is unaffected. English-only on purpose -- it never ships to a buyer's site, so it is not
// in src/i18n/. Set it alongside SITE_URL when building the demo.
const href = import.meta.env.PUBLIC_DEMO_BUY_URL;
---

{href && (
  <aside class="bg-primary text-on-primary">
    <p class="max-w-wide font-ui mx-auto px-4 py-2 text-sm">
      Gazette (free) demo ·{' '}
      <a class="text-on-primary font-medium" href={href}>
        Get Pro &rarr;
      </a>
    </p>
  </aside>
)}
