---
// Light/dark switch. The value lands on <html data-theme>, which flips
// color-scheme so every light-dark() token switches with it. No class variant.
import { useT } from '../../i18n/t';

const t = useT(Astro.currentLocale);
// The script runs before it knows the page language, so the three words ride on the button.
const labels = { system: t.themeSystem, light: t.themeLight, dark: t.themeDark };
---

<button
  type="button"
  data-theme-toggle
  data-theme-labels={JSON.stringify(labels)}
  aria-pressed="false"
  class="font-ui text-sm"
>
  <span data-theme-label>{labels.system}</span>
</button>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = button?.querySelector('[data-theme-label]');
  const order = ['system', 'light', 'dark'] as const;
  const labels: Record<string, string> = JSON.parse(button?.dataset.themeLabels ?? '{}');

  const read = () => {
    try {
      return localStorage.getItem(KEY) ?? 'system';
    } catch {
      return 'system';
    }
  };

  const apply = (value: string) => {
    if (value === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', value);
    if (label) label.textContent = labels[value] ?? value;
    button?.setAttribute('aria-pressed', String(value === 'dark'));
  };

  apply(read());
  button?.addEventListener('click', () => {
    const next = order[(order.indexOf(read() as (typeof order)[number]) + 1) % order.length];
    try {
      localStorage.setItem(KEY, next);
    } catch {}
    apply(next);
  });
</script>
