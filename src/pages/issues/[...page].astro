---
// Screen D: the archive. Every issue as a row -- number, cover line, date, piece count.
// Rows, not a grid of three cards.
import Base from '../../layouts/Base.astro';
import { archive } from '../../config';
import { fmt, useT } from '../../i18n/t';
import { formatDate, getIssueArticles, getIssues, issueHref, pad } from '../../lib/content';

// Page 1 is /issues; the rest are /issues/page/2. Numbering them /issues/2 would collide
// with issue 2's own page, which wins the route and hides the archive page silently.
export async function getStaticPaths() {
  const issues = await getIssues();
  const rows = await Promise.all(
    issues.map(async (issue) => ({
      issue,
      count: (await getIssueArticles(issue)).length,
      coverLine: issue.data.coverLine,
    })),
  );
  const size = archive.issuesPerPage;
  const total = Math.max(1, Math.ceil(rows.length / size));
  const paths = [];
  for (let i = 0; i < total; i++)
    paths.push({
      params: { page: i === 0 ? undefined : `page/${i + 1}` },
      props: { rows: rows.slice(i * size, (i + 1) * size), current: i + 1, total },
    });
  return paths;
}

const { rows, current, total } = Astro.props;
const t = useT();
const pageHref = (n: number) => (n === 1 ? '/issues' : `/issues/page/${n}`);
---

<Base title={t.archive} description={t.archiveDescription}>
  <div class="max-w-wide mx-auto px-4">
    <header class="border-foreground border-b-[3px] pt-8 pb-4 sm:pt-12">
      <h1 class="font-cover text-[clamp(2rem,9vw,3.5rem)] leading-[0.95] font-bold">{t.archive}</h1>
      <p class="font-ui text-muted mt-2 text-sm tabular-nums">
        {t.archiveDescription}
        {total > 1 && <span> &middot; {fmt(t.pageOf, { n: current, total })}</span>}
      </p>
    </header>

    <ol>
      {rows.map(({ issue, count, coverLine }) => (
        <li class="border-border border-b">
          <a
            class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-5 no-underline"
            href={issueHref(issue)}
          >
            <span class="font-ui text-primary w-16 shrink-0 text-sm tabular-nums">
              {fmt(t.issueNumber, { n: pad(issue.data.number) })}
            </span>
            <span class="font-cover max-w-[38ch] text-xl leading-tight font-bold">{coverLine}</span>
            <span class="font-ui text-muted ms-auto shrink-0 text-sm tabular-nums max-sm:basis-full max-sm:ps-20">
              {fmt(t.pieces, { n: count })} &middot; {formatDate(issue.data.date)}
            </span>
          </a>
        </li>
      ))}
    </ol>

    {total > 1 && (
      <nav
        class="font-ui mt-8 flex items-baseline justify-between gap-4 text-sm"
        aria-label={t.archivePages}
      >
        {current > 1 ? (
          <a class="hover:text-primary no-underline" href={pageHref(current - 1)}>
            &larr; {t.newerIssues}
          </a>
        ) : (
          <span />
        )}
        {current < total ? (
          <a class="hover:text-primary no-underline" href={pageHref(current + 1)}>
            {t.olderIssues} &rarr;
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </div>
</Base>
