---
// Dev-only route (injected in astro.config.mjs). Never built for production.
// This is the page to look at in light, dark, and 360px when tokens change.
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';

const colors = [
  '--background',
  '--surface',
  '--foreground',
  '--muted',
  '--border',
  '--primary',
  '--primary-hover',
  '--on-primary',
];
const sizes = ['text-xs', 'text-sm', 'text-base', 'text-lg', 'text-xl', 'text-2xl', 'text-3xl'];

// Stand-in contents rows. The real ones come from the issues collection in step 2.
const contents = [
  { n: 1, title: 'The Standing Water', by: 'Marguerite Oyelaran', dept: 'Feature' },
  { n: 2, title: 'What the Ferry Timetable Knows', by: 'Idris Pham', dept: 'Report' },
  { n: 3, title: 'Nine Notes on a Borrowed Kitchen', by: 'Rosalind Achebe-Marr', dept: 'Essay' },
  { n: 12, title: 'Correspondence', by: 'Readers', dept: 'Department' },
];
---

<Base title="Styleguide" noindex>
  <div class="mx-auto max-w-wide space-y-12 px-4 py-12">
    <header class="flex items-baseline justify-between gap-4">
      <h1 class="text-2xl font-bold">Styleguide</h1>
      <ThemeToggle />
    </header>

    <section>
      <h2 class="font-ui text-lg font-semibold">Color</h2>
      <ul class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-3">
        {colors.map((name) => (
          <li class="border-border border p-3">
            <span
              class="block h-10 w-full border border-border"
              style={`background: var(${name})`}
            />
            <code class="font-mono text-xs">{name}</code>
          </li>
        ))}
      </ul>
      <p class="text-muted mt-3 text-sm">
        Contrast is checked by <code class="font-mono">pnpm check:contrast</code>, not by eye.
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Cover</h2>
      <div class="border-foreground mt-4 border-b-[3px]">
        <p class="font-ui text-muted flex justify-between text-xs tracking-wide">
          <span>Issue 04</span>
          <span>14 March 2026</span>
        </p>
        <p class="font-cover mt-1 text-[clamp(2.5rem,10vw,7rem)] leading-[0.9] font-bold">
          Gazette
        </p>
      </div>
      <div class="bg-primary text-on-primary mt-6 p-6 sm:p-10">
        <p class="font-ui text-sm font-medium opacity-80">The cover line</p>
        <p class="font-cover mt-2 max-w-[20ch] text-3xl leading-tight font-bold italic sm:text-5xl">
          Everyone left the island, and then the water came back
        </p>
      </div>
      <p class="text-muted mt-3 text-sm">
        The spot colour arrives as a field, not as a sprinkle of labels. That is the split from
        Masthead.
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Signature — leader contents</h2>
      <ol class="border-foreground mt-4 border-t">
        {contents.map((row) => (
          <li class="border-border leaders border-b py-3">
            <span class="font-ui text-muted w-8 shrink-0 text-sm tabular-nums">{row.n}</span>
            <a class="font-cover text-lg font-bold no-underline sm:text-xl" href="#">
              {row.title}
            </a>
            <span class="leaders__fill" aria-hidden="true" />
            <span class="font-ui text-muted shrink-0 text-sm">{row.by}</span>
          </li>
        ))}
      </ol>
      <p class="text-muted mt-3 text-sm">
        Numbers are hung and tabular (<code class="font-mono">tnum</code> is present in all three
        faces). Set <code class="font-mono">contents.style = 'plain'</code> to drop the fill span.
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Folio</h2>
      <p class="border-foreground font-ui text-muted mt-4 flex justify-between border-t-[3px] pt-2 text-xs tracking-wide tabular-nums">
        <span>Issue 04</span>
        <span>Essays</span>
        <span>03 / 07</span>
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Type scale</h2>
      <dl class="mt-4 space-y-2">
        {sizes.map((size) => (
          <div class="flex items-baseline gap-4">
            <dt class="font-mono text-muted w-24 shrink-0 text-xs">{size}</dt>
            <dd class={size}>The quick brown fox jumps over the lazy dog</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Body copy</h2>
      <div class="max-w-content mt-4">
        <p>
          Body text runs at the measure set by <code class="font-mono">--content-width</code>. It
          carries <a href="#">an inline link</a>, <em>emphasis</em>,{' '}
          <strong>strong emphasis</strong>, and <code class="font-mono">inline code</code>.
        </p>
        <p class="mt-4">
          Figures run at the faces' defaults: 4 March 1998, 12 miles, £45. Neither Literata, Archivo
          nor Bodoni Moda ships <code class="font-mono">onum</code>,{' '}
          <code class="font-mono">smcp</code> or <code class="font-mono">c2sc</code>, so nothing in
          this theme may assume old-style figures or real small caps. Kickers are Archivo at small
          size and weight, never synthesised small caps.
        </p>
      </div>
    </section>
  </div>
</Base>
