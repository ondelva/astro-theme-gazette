---
import Base from '../layouts/Base.astro';
import { useT } from '../i18n/t';

const t = useT(Astro.currentLocale);
---

<Base title={t.notFoundTitle} noindex>
  <div class="max-w-content mx-auto px-4 py-24">
    <h1 class="text-3xl font-bold">{t.notFoundTitle}</h1>
    <p class="text-muted mt-4">{t.notFoundBody}</p>
    <p class="mt-4">
      <a href="/">{t.backHome}</a>
    </p>
  </div>
</Base>
